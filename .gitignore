# --- Python / Backend ---
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
*.pyc
.pytest_cache/

# --- Node / Frontend ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.turbo/

# --- Env files ---
# Catch-all: ignores .env, .env.local, .env.production, .env.development,
# .env.*.local, etc. at any depth (backend/, frontend/, or root) — a bare
# pattern with no leading slash matches at every directory level. The
# explicit exception keeps committed example/template files trackable.
.env*
!.env.example
!**/.env.example

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs ---
*.log
npm-debug.log*
