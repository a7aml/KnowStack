# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000

# --- Auth (session JWTs issued by this backend) ---
# No default in code — startup fails if this is missing, too short (<32
# chars), or a known placeholder, whenever ENVIRONMENT != development.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Transactional email (employee invites, via Resend) ---
# Left empty: email_service logs instead of sending when unset, which is
# fine for local dev but must be set for a real deployment.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Frontend (Next.js public vars) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
